# SupplyPulse Database & Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual secrets.

POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supplypulse

# SQLAlchemy Database URL
DATABASE_URL=postgresql://your_postgres_username:your_postgres_password@localhost:5432/supplypulse

# JWT Security Configuration
SECRET_KEY=replace_with_a_secure_random_32_byte_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Mode (set to true ONLY for mock demonstration without database)
DEMO_MODE=false
